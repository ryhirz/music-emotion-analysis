# ===================== 虚拟环境与缓存 =====================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ===================== 原始音频数据（体积庞大，不入库）=====================
# GTZAN 原始音频约 1.3GB，请通过 scripts/download_gtzan.py 重新获取，不要提交进仓库。
data/genres_original/
data/_tmp_extract/

# 全局排除音频文件（防止任何意外的大音频混入；assets/ 为 png 不受影响）
*.mp3
*.wav
*.au
*.flac
*.ogg

# ===================== 临时文件 =====================
temp_*
*.tmp
tmp/

# ===================== 模型训练过程产物（可选排除）=====================
# 注意：models/*.joblib 体积很小（<300KB），建议保留以便 clone 后开箱即用。
# 下面仅排除可能的临时模型/日志，不排除正式模型文件。
models/*.log

# ===================== 系统与编辑器 =====================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ===================== WorkBuddy 内部目录（隐私，不入库）=====================
.workbuddy/
